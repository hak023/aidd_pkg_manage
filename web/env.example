# AX_AIDD 환경 변수 목록. 실제 값은 web/.env.local(로컬) 또는 Vercel 환경 변수에 넣는다.
# 이 파일에는 실제 비밀값을 쓰지 않는다.
# 로컬 개발(next dev)에서 LOGIN_* / AUTH_SECRET이 비어 있으면 개발용 기본값(admin / admin)을 쓴다.
# 운영(production)에서는 셋 중 하나라도 비어 있으면 로그인이 거부된다.

# 더미 로그인 계정 (D-03)
LOGIN_ID=
LOGIN_PASSWORD=
# 로그인 쿠키 서명용 임의 문자열 (32자 이상 권장)
AUTH_SECRET=

# DB: 비워 두면 로컬 PGlite(web/.data/pglite) 사용. 배포 시 Neon 연결 문자열 입력.
DATABASE_URL=

# --- 이하 P2 이후 사용 ---
# 시스템용 Gmail 계정 (2단계 인증 + 앱 비밀번호)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 수집·진행상황 요청 메일을 받을 회사 주소
COLLECT_TO_ADDRESS=
# Gemini (유료 등급 키)
GEMINI_API_KEY=
GEMINI_MODEL=
# 외부 크론이 메일 확인 주소를 호출할 때 쓰는 비밀값
POLL_SECRET=
# true면 실제 메일 대신 가상 메일함 사용
SIMULATOR_MODE=true
