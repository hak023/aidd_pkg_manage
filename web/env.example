# AX_AIDD 환경 변수 목록. 실제 값은 web/.env.local(로컬) 또는 Vercel 환경 변수에 넣는다.
# 이 파일에는 실제 비밀값을 쓰지 않는다.
# 로컬 개발(next dev)에서 LOGIN_* / AUTH_SECRET이 비어 있으면 개발용 기본값(admin / admin)을 쓴다.
# 운영(production)에서는 셋 중 하나라도 비어 있으면 로그인이 거부된다.

# 더미 로그인 계정 (D-03)
LOGIN_ID=
LOGIN_PASSWORD=
# 로그인 쿠키 서명용 임의 문자열 (32자 이상 권장)
AUTH_SECRET=

# --- 다중 사용자 (2026-11-22, docs/guides/배포-가이드.md 10장) ---
# 값이 있으면 위 LOGIN_ID / LOGIN_PASSWORD와 아래 전역 GMAIL_* 대신 사용자별 값을 쓴다.
# 해시는 npm run hash-password 로 만든다. ID는 소문자, 환경 변수 이름에는 대문자.
AUTH_USERS=
# USER_<ID>_PASSWORD_HASH=
# USER_<ID>_NAME=
# USER_<ID>_GMAIL_ADDRESS=
# USER_<ID>_GMAIL_APP_PASSWORD=
# USER_<ID>_COLLECT_TO_ADDRESS=

# DB: 비워 두면 로컬 PGlite(web/.data/pglite) 사용. 배포 시 Neon 연결 문자열 입력.
DATABASE_URL=

# --- 메일 (P2) — docs/guides/메일-연동-가이드.md 참고 ---
# 아래 셋이 모두 있으면 Gmail 모드, 없으면 로컬에서는 시뮬레이터 모드(가상 메일함)
# 시스템용 Gmail 계정 (2단계 인증 + 앱 비밀번호)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# 수집·진행상황 요청 메일을 받을 회사 주소 (자동 발송은 이 주소로만 간다)
COLLECT_TO_ADDRESS=
# true면 실제 메일 대신 가상 메일함 사용 (Gmail 값이 있어도 우선)
SIMULATOR_MODE=
# 최근 24시간 실제 발송 한도 (Gmail 계정별, 기본 30)
MAIL_DAILY_LIMIT=
# 첫 메일 확인 때 거슬러 볼 일수 (기본 3)
MAIL_LOOKBACK_DAYS=

# --- Gemini (P3) ---
# 유료 등급 키. 로컬에서 비우면 모의 LLM, 운영에서 비우면 LLM 기능 오류
GEMINI_API_KEY=
# 비우면 Flash-Lite 최신 안정 버전 자동 선택
GEMINI_MODEL=
# 작업별 모델 (비우면 GEMINI_MODEL): L1 회신 점검 / L2 PRD 생성
GEMINI_MODEL_REVIEW=
GEMINI_MODEL_PRD=
# P4: L3 수신 문서 분류 / L4·L5 Architecture·QA 점검
GEMINI_MODEL_CLASSIFY=
GEMINI_MODEL_DOCREVIEW=
# P5: L6 진행상황 회신 해석 (양식 표가 깨졌을 때만 사용)
GEMINI_MODEL_PROGRESS=
# true면 키가 있어도 모의 LLM 사용 (시연 연습·시험용)
LLM_MOCK=
